# ============================================================
# TestForge — example environment configuration
# Copy this file to .env and update values before use.
# NEVER commit .env to version control.
# ============================================================

# Database
# Default: SQLite in repo root.  Override for PostgreSQL etc.
DATABASE_URL=sqlite+aiosqlite:///./testforge.db

# JWT Auth — DEMO ONLY.  Replace with a real 32+ char secret.
SECRET_KEY=DEMO-ONLY-NOT-SECRET-change-before-any-real-use
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Debug mode (true enables SQL logging)
DEBUG=false
